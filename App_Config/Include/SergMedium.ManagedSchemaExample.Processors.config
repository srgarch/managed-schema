<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <pipelines>
      <contentSearch.PopulateSolrSchema>
        <processor patch:after="processor[@type='Sitecore.ContentSearch.SolrProvider.Pipelines.PopulateSolrSchema.PopulateFields, Sitecore.ContentSearch.SolrProvider']"
                   type="SergMedium.ManagedSchemaExample.Processors.PopulateCustomIndexes, SergMedium.ManagedSchemaExample" />
        <processor patch:instead="processor[@type='Sitecore.ContentSearch.SolrProvider.Pipelines.PopulateSolrSchema.PopulateFields, Sitecore.ContentSearch.SolrProvider']"
                   type="Sitecore.ContentSearch.SolrProvider.Pipelines.PopulateSolrSchema.PopulateFields, Sitecore.ContentSearch.SolrProvider">
          <param type="SergMedium.ManagedSchemaExample.Processors.CustomPopulateHelperFactory, SergMedium.ManagedSchemaExample"/>
        </processor>
      </contentSearch.PopulateSolrSchema>
    </pipelines>
  </sitecore>
</configuration>